# ==================================================
# KrushiSetu - Environment Configuration Template
# COPY THIS TO .env AND FILL IN YOUR ACTUAL CREDENTIALS
# DO NOT COMMIT THE .env FILE TO VERSION CONTROL
# ==================================================

# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_chars

# MongoDB Database (Atlas or Local)
# Example Local: mongodb://localhost:27017/krushisetu_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/krushisetu_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/krushisetu_db
DB_NAME=krushisetu_db

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_super_secure_jwt_secret_token
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# AI Model Endpoints / API Keys (Optional Integrations)
WEATHER_API_KEY=your_weather_api_key_here
MANDI_PRICE_API_KEY=your_gov_data_api_key_here

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload
